<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Placeholders only. Use user-secrets or web.Local.config for real values. -->
  <connectionStrings>
    <add name="WeddingDb" providerName="Npgsql" connectionString="" />
  </connectionStrings>
  <appSettings>
    <add key="Cors:AllowedOrigins:0" value="http://localhost:5173" />
    <add key="Paths:Export" value="App_Data/Exports" />
    <add key="Paths:Import" value="App_Data/Imports" />
    <add key="Paths:Logs" value="App_Data/Logs" />
    <!-- Supabase URL/key and JWT issuer are configured through appsettings.json. -->
    <add key="Authentication:Audience" value="authenticated" />
    <!-- Comma-separated Supabase Auth user UUIDs, controlled by the server operator. -->
    <add key="Authentication:AdminUserIds" value="" />
    <add key="Attendance:ArrivedStatusId" value="0" />
  </appSettings>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\WeddingSystem.dll" stdoutLogEnabled="false" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
